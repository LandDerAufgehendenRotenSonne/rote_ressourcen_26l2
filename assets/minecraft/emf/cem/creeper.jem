			"animations": [
				{
					"center_stem.ry": "-rot_y",
					"var.comment": "0",
					"var.distance_threshhold": "5",
					"varb.is_near": "distance<=var.distance_threshhold",
					"var.max_nearness": "100",
					"var.min_nearness": "0",
					"var.step_nearness": "min((var.max_nearness-2*abs(var.max_nearness/2-var.nearness))/10+0.1,10)/8",
					"var.nearness": "if(varb.is_near,if(var.max_nearness>var.nearness,var.nearness+var.step_nearness,var.max_nearness),if(var.min_nearness<var.nearness,var.nearness-var.step_nearness,var.min_nearness))",
					"branch1.ry": "torad(var.nearness/2)+sin(sin(time/10)/10)/10*var.nearness/100",
					"branch1.rz": "torad(var.nearness/8)+sin(sin(time/10)/10)/10*var.nearness/100",
					"subbranch1.rz": "torad(var.nearness/3)+sin(sin(time/10)/10)/10*var.nearness/100",
					"chead1.rz": "torad(var.nearness/5)+sin(sin(time/10)/10)/10*var.nearness/100",
					"branch2.ry": "torad(-var.nearness/1.5)+sin(sin(time/10)/10)/10*var.nearness/100",
					"branch2.rz": "torad(var.nearness/5)+sin(sin(time/10)/10)/10*var.nearness/100",
					"subbranch2.rz": "torad(var.nearness/2)+sin(sin(time/10)/10)/10*var.nearness/100",
					"chead2.rz": "torad(var.nearness/5)+sin(sin(time/10)/10)/10*var.nearness/100",
					"branch3.ry": "torad(-var.nearness/20)+sin(sin(time/10)/10)/10*var.nearness/100",
					"branch3.rz": "torad(-var.nearness/2)+sin(sin(time/10)/10)/10*var.nearness/100",
					"chead3.rz": "torad(-var.nearness/5)+sin(sin(time/10)/10)/10*var.nearness/100",
					"flower_branch.ty": "min(8,max(0,(var.max_nearness-var.nearness)/10))",
					"flower_branch2.ry": "torad(var.nearness/6)",
					"flower_branch2.ty": "min(16,max(0,(var.max_nearness-var.nearness)/10))",
					"flower.ry": "torad(var.nearness/2)",
					"petal.rx": "torad(var.max_nearness*1.2-var.nearness)+var.nearness/100*sin(sin(10+time/10)/10)",
					"petal2.rx": "torad(var.max_nearness*1.2-var.nearness)+var.nearness/100*sin(sin(20+time/10)/10)",
					"petal3.rx": "torad(var.max_nearness*1.2-var.nearness)+var.nearness/100*sin(sin(30+time/10)/10)",
					"petal4.rx": "torad(var.max_nearness*1.2-var.nearness)+var.nearness/100*sin(sin(40+time/10)/10)",
					"petal5.rx": "torad(var.max_nearness*1.2-var.nearness)+var.nearness/100*sin(sin(50+time/10)/10)",
					"petal6.rx": "torad(var.max_nearness*1.2-var.nearness)+var.nearness/100*sin(sin(60+time/10)/10)",
					"eye.sx": "var.nearness/100",
					"eye.sy": "var.nearness/100",
					"eye.sz": "var.nearness/100",
					"eye.ty": "16+(var.nearness/100*-20)",
					"eye.ry": "rot_y+head.ry",
					"eye.rx": "head.rx"
				}
			]
		},
