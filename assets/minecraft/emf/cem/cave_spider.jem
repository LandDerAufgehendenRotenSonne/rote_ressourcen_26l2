			"animations": [
				{
					"var.counter": "var.counter+if(is_aggressive,0.2,0.1)*random(var.counter)",
					"var.randcurve": "(if(is_aggressive,2,4)*var.randcurve+(-0.5+random(floor(var.counter)))/if(is_aggressive,2,10) )/if(is_aggressive,3,5)",
					"var.angle": "if(is_aggressive,var.angle+if(var.angle<=45,2,0),var.angle-if(var.angle>=0,2,0))",
					"var.speed": "2.0",
					"var.wobble": "0.1",
					"var.wiggle": "0.8",
					"var.delay": "2",
					"var.head_angle": "if(is_aggressive,if(var.head_angle>=30,30,var.head_angle+1),if(var.head_angle<=0,0,var.head_angle-1))",
					"cow_head.rx": "head.rx+torad(-var.head_angle)",
					"cow_head.ry": "head.ry",
					"jaw.rx": "torad(var.head_angle*2)",
					"jaw.rz": "if(is_aggressive,sin(0.9*limb_swing)*0.1,0)",
					"snout.ty": "(-var.head_angle)/15-0.5",
					"cow_head.rz": "var.randcurve",
					"cow_body.rz": "-cow_head.rz/2",
					"cow_leg1.rz": "sin(limb_swing*var.speed)*limb_speed*var.wobble+torad(var.angle)",
					"cow_leg1.rx": "sin(limb_swing*var.speed)*limb_speed*var.wiggle",
					"cow_leg2.rz": "sin(var.delay+limb_swing*var.speed)*limb_speed*var.wobble+torad(var.angle)",
					"cow_leg2.rx": "sin(var.delay+limb_swing*var.speed)*limb_speed*var.wiggle",
					"cow_leg3.rz": "sin(var.delay+limb_swing*var.speed)*limb_speed*var.wobble+torad(-var.angle)",
					"cow_leg3.rx": "sin(var.delay+limb_swing*var.speed)*limb_speed*var.wiggle",
					"cow_leg4.rz": "sin(2*var.delay+limb_swing*var.speed)*limb_speed*var.wobble+torad(-var.angle)",
					"cow_leg4.rx": "sin(2*var.delay+limb_swing*var.speed)*limb_speed*var.wiggle"
				}
			]
