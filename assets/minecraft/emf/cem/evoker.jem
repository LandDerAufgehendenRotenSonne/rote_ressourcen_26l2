					"v2.visible": "varb.version",
					"v1.visible": "!varb.version",
					"var.pulsespeed": "if(is_aggressive&&var.pulsespeed<0.5,var.pulsespeed+0.1,if(!is_aggressive&&var.pulsespeed>0,var.pulsespeed-0.1,var.pulsespeed))",
					"dots.sy": "1+sin(0.5+time*var.pulsespeed)*0.02",
					"dots.sz": "1+sin(1+time*var.pulsespeed)*0.02",
					"dots.sx": "1+sin(1.5+time*var.pulsespeed)*0.02",
					"v1.sy": "0.95+sin(0.5+time*var.pulsespeed)*0.05",
					"v1.sz": "0.95+sin(1+time*var.pulsespeed)*0.05",
					"v1.sx": "0.95+sin(1.5+time*var.pulsespeed)*0.05",
					"stem1.ty": "if(is_aggressive,-9.25+sin(time*0.2)*0.6,stem1.ty)",
					"stem2.ty": "if(is_aggressive,-9.5+sin(time*0.3+0.5)*0.4,stem2.ty)",
					"stem1.rx": "sin(time*0.02+0)*0.05",
					"stem2.rx": "sin(time*0.02+0.5)*0.05",
