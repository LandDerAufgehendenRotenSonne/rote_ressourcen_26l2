			"animations": [
				{
					"body.rx": "torad(0)",
					"scale.sx": "3",
					"scale.sy": "3",
					"scale.sz": "3",
					"scale.ty": "-27",
					"var.random": "max(0,min(1,if(var.random>0,var.random-0.01,round(random(time)*150-149))))",
					"var.random1": "max(0,min(1,if(var.random1>0,var.random1-0.05,round(random(time+420.67)*150-149))))",
					"var.random11": "max(0,min(1,if(var.random1>0,var.random11+0.1,var.random11-0.1)))",
					"var.swing_progress1": "max(0,min(1,var.swing_progress1+swing_progress/2-0.03))",
					"var.swing_progress2": "max(0,min(1,var.swing_progress2+swing_progress/1.5-0.04))",
					"var.step_max": "10",
					"var.speed": "0.5",
					"var.step": "round(limb_swing*limb_speed*var.speed)%10",
					"var.amt_thighrot": "5",
					"var.amt_thighshiftx": "0.4",
					"var.amt_thighshifty": "0.5",
					"var.step_offset": "5",
					"var.step_thighrot_start": "1",
					"var.step_thighrot_end": "4",
					"var.step_thighshiftx_start": "3",
					"var.step_thighshiftx_end": "5",
					"var.step_thighshifty_start": "1",
					"var.step_thighshifty_end": "3",
					"var.thighrot1": "if(var.step==0,0,if(var.step==var.step_thighrot_start,var.thighrot1+var.amt_thighrot,if(var.step==var.step_thighrot_end,var.thighrot1-var.amt_thighrot,var.thighrot1)))",
					"var.thighshiftx1": "if(var.step==0,0,if(var.step==var.step_thighshiftx_start,var.thighshiftx1-var.amt_thighshiftx,if(var.step==var.step_thighshiftx_end,var.thighshiftx1+var.amt_thighshiftx,var.thighshiftx1)))",
					"var.thighshifty1": "if(var.step==0,0,if(var.step==var.step_thighshifty_start,var.thighshifty1-var.amt_thighshifty,if(var.step==var.step_thighshifty_end,var.thighshifty1+var.amt_thighshifty,var.thighshifty1)))",
					"thigh1.rz": "(torad(var.thighrot1)-torad(var.thighrot2))*limb_speed",
					"thigh1.tx": "var.thighshiftx1*limb_speed",
					"thigh1.ty": "var.thighshifty1*limb_speed",
					"calf1.rz": "-thigh1.rz*0.75",
					"foot1.rz": "-thigh1.rz*0.25",
					"var.thighrot2": "if(var.step==var.step_offset,0,if(var.step==(var.step_thighrot_start+var.step_offset)%var.step_max,var.thighrot2+var.amt_thighrot,if(var.step==(var.step_thighrot_end+var.step_offset)%var.step_max,var.thighrot2-var.amt_thighrot,var.thighrot2)))",
					"var.thighshiftx2": "if(var.step==var.step_offset,0,if(var.step==(var.step_thighshiftx_start+var.step_offset)%var.step_max,var.thighshiftx2-var.amt_thighshiftx,if(var.step==(var.step_thighshiftx_end+var.step_offset)%var.step_max,var.thighshiftx2+var.amt_thighshiftx,var.thighshiftx2)))",
					"var.thighshifty2": "if(var.step==var.step_offset,0,if(var.step==(var.step_thighshifty_start+var.step_offset)%var.step_max,var.thighshifty2-var.amt_thighshifty,if(var.step==(var.step_thighshifty_end+var.step_offset)%var.step_max,var.thighshifty2+var.amt_thighshifty,var.thighshifty2)))",
					"thigh2.rz": "(torad(var.thighrot2)-torad(var.thighrot1))*limb_speed",
					"thigh2.tx": "var.thighshiftx2*limb_speed",
					"thigh2.ty": "var.thighshifty2*limb_speed",
					"bicep1.rx": "lerp(var.swing_progress1,(torad(var.thighrot1)-torad(var.thighrot2))/4,torad(-93))",
					"bicep1.rz": "lerp(var.swing_progress1,0,1.5)",
					"forearm1.rx": "lerp(var.swing_progress2,(-torad(var.thighrot1))*0.2-torad(90),0)",
					"bicep2.rx": "lerp(var.swing_progress1,(torad(var.thighrot2)-torad(var.thighrot1))/4,torad(-93))",
					"bicep2.rz": "lerp(var.swing_progress1,0,-1.5)",
					"forearm2.rx": "lerp(var.swing_progress2,(-torad(var.thighrot2))*0.2-torad(90),0)",
					"hand1.ry": "torad(20+360*var.random)",
					"hand2.ry": "-hand1.ry",
					"index1.rz": "torad(20)+torad(-40*var.random11)",
					"index2.rz": "torad(-60)+index1.rz/2",
					"middle1.rz": "torad(23)+torad(-20*var.random11)",
					"middle2.rz": "torad(-70)+middle1.rz",
					"ring1.rz": "torad(21)+torad(-40*var.random11)",
					"ring2.rz": "torad(-80)+ring1.rz/1.5",
					"thumb1.rz": "torad(-35)+torad(10*var.random11)",
					"thumb2.rz": "torad(92)+thumb1.rz/1.5",
					"index3.rz": "-index1.rz",
					"index4.rz": "-index2.rz",
					"calf2.rz": "-thigh2.rz*0.75",
					"foot2.rz": "-thigh2.rz*0.25"
				}
			]
		},
