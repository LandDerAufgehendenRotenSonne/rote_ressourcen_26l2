				{
					"var.step": "0.05",
					"var.str": "if(var.str<move_strafing,var.str+var.step,if(var.str>move_strafing,var.str-var.step,var.str))",
					"var.frw": "if(var.frw<move_forward,var.frw+var.step,if(var.frw>move_forward,var.frw-var.step,var.frw))",
					"var.wheelrot": "var.wheelrot+torad((round(var.frw*10)/10)*7+min(0,move_forward)*-3)",
					"hind_wheel.rx": "var.wheelrot",
					"front_wheel.rx": "var.wheelrot",
					"pedals.rx": "var.wheelrot/2",
					"pedal1.rx": "-pedals.rx",
					"pedal2.rx": "-pedals.rx",
					"steering.ry": "if(is_ridden,var.str/2,torad(80))",
					"bicycle.rz": "if(is_ridden,-var.str/4,torad(85))",
					"bicycle.ry": "if(is_ridden,0,torad(5))",
					"bicycle.ty": "if(is_ridden,-16,-5)"
				}
