			"animations": [
				{
					"var.leg_tilt": "torad(-30)",
					"var.leg_swing": "3",
					"var.leg_speed": "2",
					"var.foot_multiplier": "0",
					"var.foot_tilt": "0",
					"hind_leg_right.rx": "var.leg_tilt+sin(limb_swing*var.leg_speed)*limb_speed*var.leg_swing",
					"hind_foot_right.rx": "-hind_leg_right.rx+hind_leg_right.rx*var.foot_multiplier+var.foot_tilt",
					"hind_leg_left.rx": "2*var.leg_tilt-hind_leg_right.rx",
					"hind_foot_left.rx": "-hind_leg_left.rx+hind_leg_left.rx*var.foot_multiplier+var.foot_tilt",
					"body_main.rx": "torad(50)+sin(limb_swing*1+0.5)*min(0.5,limb_speed)*0.3",
					"body_upper.rx": "body_main.rx/2",
					"var.headrx": "(head.rx+var.headrx*2)/3",
					"head_main.rx": "var.headrx-body_main.rx+torad(-90)",
					"head_main.ry": "head.ry/2",
					"head_main.rz": "head.ry",
					"var.anger": "min(1, max(0, if(!is_aggressive && var.anger <= 1,var.anger+0.01,if(is_aggressive && var.anger <= 1,var.anger - 0.01, var.anger))))",
					"mandible.rx": "torad(var.anger*var.anger*var.anger*200)+sin(time/10)/10",
					"mandible2.rx": "mandible.rx-sin(time/10+10)/15",
					"front_leg_right.rx": "torad(-73)+sin(limb_swing*var.leg_speed+2)*limb_speed*0.4",
					"front_leg_left.rx": "torad(-73)+sin(limb_swing*var.leg_speed+3)*limb_speed*0.4"
				}
