{
  "multipart": [
    {
      "apply": {
        "model": "ldars:block/brewing_stand/brewing_stand"
      }
    },
    {
      "apply": {
        "model": "ldars:block/brewing_stand/bottle0"
      },
      "when": {
        "has_bottle_0": "true"
      }
    },
    {
      "apply": {
        "model": "ldars:block/brewing_stand/bottle1"
      },
      "when": {
        "has_bottle_1": "true"
      }
    },
    {
      "apply": {
        "model": "ldars:block/brewing_stand/bottle2"
      },
      "when": {
        "has_bottle_2": "true"
      }
    },
    {
      "apply": {
        "model": "ldars:block/brewing_stand/empty0"
      },
      "when": {
        "has_bottle_0": "false"
      }
    },
    {
      "apply": {
        "model": "ldars:block/brewing_stand/empty1"
      },
      "when": {
        "has_bottle_1": "false"
      }
    },
    {
      "apply": {
        "model": "ldars:block/brewing_stand/empty2"
      },
      "when": {
        "has_bottle_2": "false"
      }
    }
  ]
}