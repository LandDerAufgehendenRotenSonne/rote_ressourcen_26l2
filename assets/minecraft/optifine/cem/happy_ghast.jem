			"animations": [
				{
					"white_acl_cover.visible": "floor(frame_counter/50)%2==0",
					"white_acl.visible": "!white_acl_cover.visible",
					"red_acl_cover.visible": "floor((10+frame_counter)/50)%2==0",
					"red_acl.visible": "!red_acl_cover.visible",
					"var.thrf": "0.5",
					"var.thrb": "-0.5",
					"var.thrl": "-0.5",
					"var.thrr": "0.5",
					"var.animstep_forward": "0.3",
					"var.animstep_backward": "0.5",
					"var.front_angle": "15",
					"var.side_angle": "10",
					"var.front_tilt": "if(move_forward<var.thrb,0,clamp(if(move_forward>var.thrf,   var.front_tilt + var.animstep_forward * frame_time, var.front_tilt - var.animstep_backward * frame_time), 0, torad(var.front_angle)))",
					"var.back_tilt": "if(move_forward>var.thrf,0,clamp(if(move_forward<var.thrb,   var.back_tilt  - var.animstep_forward * frame_time, var.back_tilt  + var.animstep_backward * frame_time), torad(-var.front_angle), 0))",
					"var.right_tilt": "if(move_strafing<var.thrl,0,clamp(if(move_strafing>var.thrr, var.right_tilt - var.animstep_forward * frame_time, var.right_tilt + var.animstep_backward * frame_time), torad(-var.side_angle), 0))",
					"var.left_tilt": "if(move_strafing>var.thrr,0,clamp(if(move_strafing<var.thrl, var.left_tilt  + var.animstep_forward * frame_time, var.left_tilt  - var.animstep_backward * frame_time), 0, torad(var.side_angle)))",
					"var.rotor_speed": "clamp(height_above_ground, 1, 5)+abs(move_forward+move_strafing)",
					"main_rotor.ry": "(age/10)*var.rotor_speed",
					"body.rx": "var.back_tilt+var.front_tilt",
					"body.rz": "var.right_tilt+var.left_tilt",
					"side_rotor.rx": "main_rotor.ry*1.2",
					"var.power": "max(1,var.rotor_speed)",
					"var.north": "rot_y+1*pi",
					"indicator2.rz": "floor(4*var.north/(2*pi))*0.5*pi",
					"indicator2.ry": "floor(8*(var.north+0.25*pi)/(2*pi))%2*pi",
					"indicator2.sz": "0.001",
					"indicator.sy": "var.power",
					"indicator.ty": "-24-indicator.sy*0.5",
					"joystick.rx": "body.rx*2+torad(-15)",
					"joystick.rz": "body.rz*2"
				}
			]
		},
