{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "pneumatic_tube",
        "model": {
          "type": "minecraft:select",
          "cases": [
            {
              "model": {
                "type": "minecraft:condition",
                "on_false": {
                  "type": "minecraft:range_dispatch",
                  "property": "minecraft:bundle/fullness",
                  "scale": 1,
                  "entries": [
                    {
                      "threshold": 0,
                      "model": {
                        "type": "minecraft:model",
                        "model": "ldars:item/pneumatic_tube_system/pink/pink"
                      }
                    },
                    {
                      "threshold": 0.01,
                      "model": {
                        "type": "minecraft:model",
                        "model": "ldars:item/pneumatic_tube_system/pink/pink_full_1"
                      }
                    },
                    {
                      "threshold": 0.8,
                      "model": {
                        "type": "minecraft:model",
                        "model": "ldars:item/pneumatic_tube_system/pink/pink_full_2"
                      }
                    }
                  ]
                },
                "on_true": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "ldars:item/pneumatic_tube_system/pink/pink_open_back"
                    },
                    {
                      "type": "minecraft:bundle/selected_item"
                    },
                    {
                      "type": "minecraft:model",
                      "model": "ldars:item/pneumatic_tube_system/pink/pink_open_front"
                    }
                  ]
                },
                "property": "minecraft:bundle/has_selected_item"
              },
              "when": "gui"
            }
          ],
          "fallback": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:bundle/fullness",
            "scale": 1,
            "entries": [
              {
                "threshold": 0,
                "model": {
                  "type": "minecraft:model",
                  "model": "ldars:item/pneumatic_tube_system/pink/pink"
                }
              },
              {
                "threshold": 0.01,
                "model": {
                  "type": "minecraft:model",
                  "model": "ldars:item/pneumatic_tube_system/pink/pink_full_1"
                }
              },
              {
                "threshold": 0.8,
                "model": {
                  "type": "minecraft:model",
                  "model": "ldars:item/pneumatic_tube_system/pink/pink_full_2"
                }
              }
            ]
          },
          "property": "minecraft:display_context"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "cases": [
        {
          "model": {
            "type": "minecraft:condition",
            "on_false": {
              "type": "minecraft:model",
              "model": "minecraft:item/pink_bundle"
            },
            "on_true": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/pink_bundle_open_back"
                },
                {
                  "type": "minecraft:bundle/selected_item"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/pink_bundle_open_front"
                }
              ]
            },
            "property": "minecraft:bundle/has_selected_item"
          },
          "when": "gui"
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/pink_bundle"
      },
      "property": "minecraft:display_context"
    }
  }
}